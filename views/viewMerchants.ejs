<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    This is the merchant view page.
    <br />
    <a href="/merchants/add-merchant">Add Merchant</a>

    <% if (locals.merchants) { %>
      <% merchants.forEach(merchant => { %>
        <li>
          Business Name: <%= merchant.legal_name %>, Account ID: <%= merchant.account_id %>, Acceptor ID: <%= merchant.acceptor_id %>
          <a href="/merchants/<%= merchant.id %>/processing-profiles">Processing Profiles</a>
          <form action="/merchants/<%= merchant.id %>/delete" method="POST" style="display:inline;">
            <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
          </form>
        </li>
      <% }); %>
    <% } %>
</body>
</html>