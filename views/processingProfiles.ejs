<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Processing Profile</title>
    <script src="/js/processingProfiles.js" defer></script>
</head>
<body>
    Business Name: <%= merchant.legal_name %>, Account ID: <%= merchant.account_id %>, Acceptor ID: <%= merchant.acceptor_id %>
    <% if (locals.processingProfiles) { %>
      <% processingProfiles.forEach(profile => { %>
        <li class="<%= merchant.id %>">
          <h3>Market Type</h3><p id="<%= profile.market_type %>"><%= profile.market_type %></p>
          <h3>Terminal ID</h3><p id="<%= profile.terminal_id %>"><%= profile.terminal_id %></p>
          <form action="/merchants/<%= merchant.id %>/processing-profiles/delete" method="POST" style="display:inline;">
            <button type="submit">Remove</button>
          </form>
          
        </li>
      <% }); %>
    <% } %>
    <br />
    <form action="/merchants/<%= merchant.id %>/processing-profiles" method="POST">
        Add Processing Profile: <br />
        <label for="market_type">Market Type</label>
        <select name="market_type">
            <option value="retail">Retail</option>
            <option value="restaurant">Restaurant</option>
            <option value="ecomm">Ecommerce</option>
            <option value="moto">Direct Marketing (MOTO)</option>
        </select>
        <label for="terminal_id">Terminal ID</label>
        <input type="text" inputmode="numeric" name="terminal_id" minlength="4" maxlength="4" required id="terminal_id">
        <button type="submit">Submit</button>
    </form>
    <a href="/merchants">Back to Merchants List</a>
    
</body>
</html>